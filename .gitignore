# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user and shared workspace data
xcuserdata/
xcshareddata/
*.xcuserstate
*.xcuserdatad/

# Xcode derived data and build artifacts
DerivedData/
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods (not used, but exclude if added later)
Pods/
Podfile.lock

# Fastlane (not used, but exclude if added later)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# Certificates and provisioning (never commit these)
*.p12
*.mobileprovision
*.cer
*.p8
*.pem

# Archives and build products
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip

# Environment / secrets (never commit these)
.env
.env.*
GoogleService-Info.plist

# Internal QA scratchpad — round-by-round screenshots, DEBUG dumps, device
# info text (may contain device serials/UDIDs), never meant for the public
# repo. Added for the GitHub public/job-hunt release round; not retroactive
# (files already committed before this round are unaffected — see the
# separate Final Report note on already-tracked files).
scratchpad/

# Internal AI-session continuity notes (not polished documentation, and can
# contain local absolute paths with the developer's real machine username).
docs/CLAUDE_CHECKPOINT.md
